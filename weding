        }

        .custom-bg-cover {
            background-image: linear-gradient(var(--overlay-cover), var(--overlay-cover)), var(--bg-cover-image);
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        .custom-bg-main {
            background-image: linear-gradient(var(--overlay-main), var(--overlay-main)), var(--bg-main-image);
